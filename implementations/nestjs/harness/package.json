{
  "name": "backend-service-playbook-nestjs-harness",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS evaluation harness for the backend-service-playbook",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "evaluate": "tsx evaluators/cli/run.ts",
    "test:evaluators": "tsx tests/run-fixtures.ts",
    "test:meta": "tsx tests/run-meta.ts",
    "test:profile": "tsx tests/run-profile.ts",
    "build:skill": "esbuild evaluators/cli/run.ts --bundle --platform=node --target=node20 --format=cjs --external:typescript --log-level=warning --outfile=../../../skills/nestjs-architecture-harness/scripts/harness.cjs"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0"
  }
}
